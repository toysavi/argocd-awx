---
apiVersion: awx.ansible.com/v1beta1
kind: AWX
metadata:
  name: {{ awx_instance_name }}
  namespace: {{ awx_namespace }}
spec:
  admin_user:             {{ awx_admin_user }}
  admin_email:            {{ awx_admin_email }}
  admin_password_secret:  {{ awx_instance_name }}-admin-password

  # AWX operator manages the Service; Traefik IngressRoute handles external access
  ingress_type: none
  hostname: {{ awx_fqdn }}

  replicas: {{ awx_replicas }}

  postgres_configuration_secret: {{ awx_instance_name }}-postgres-configuration
  postgres_storage_class: {{ awx_postgres_storage_class }}
  postgres_storage_requirements:
    requests:
      storage: {{ awx_postgres_storage_size }}

  web_resource_requirements:
    requests:
      cpu:    "{{ awx_web_resources.requests.cpu }}"
      memory: "{{ awx_web_resources.requests.memory }}"
    limits:
      cpu:    "{{ awx_web_resources.limits.cpu }}"
      memory: "{{ awx_web_resources.limits.memory }}"

  task_resource_requirements:
    requests:
      cpu:    "{{ awx_task_resources.requests.cpu }}"
      memory: "{{ awx_task_resources.requests.memory }}"
    limits:
      cpu:    "{{ awx_task_resources.limits.cpu }}"
      memory: "{{ awx_task_resources.limits.memory }}"

  extra_settings:
{% for s in awx_extra_settings %}
    - setting: {{ s.setting }}
      value: "{{ s.value }}"
{% endfor %}
