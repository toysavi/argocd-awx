---
# Traefik IngressRoute CRD (native k3s Traefik)
# Port 443 → argocd-server:80 (HTTP, TLS terminated here at Traefik)
apiVersion: traefik.io/v1alpha1
kind: IngressRoute
metadata:
  name: argocd-server-https
  namespace: {{ argocd_namespace }}
spec:
  entryPoints:
    - websecure          # port 443 — Traefik built-in entrypoint
  routes:
    - match: Host(`{{ argocd_fqdn }}`)
      kind: Rule
      services:
        - name: argocd-server
          port: 80        # ArgoCD runs HTTP internally (--insecure flag)
  tls:
    secretName: argocd-tls   # Secret created by cert-manager Certificate above
---
# Redirect HTTP → HTTPS
apiVersion: traefik.io/v1alpha1
kind: IngressRoute
metadata:
  name: argocd-server-http-redirect
  namespace: {{ argocd_namespace }}
spec:
  entryPoints:
    - web                # port 80
  routes:
    - match: Host(`{{ argocd_fqdn }}`)
      kind: Rule
      middlewares:
        - name: argocd-https-redirect
      services:
        - name: argocd-server
          port: 80
---
apiVersion: traefik.io/v1alpha1
kind: Middleware
metadata:
  name: argocd-https-redirect
  namespace: {{ argocd_namespace }}
spec:
  redirectScheme:
    scheme: https
    permanent: true
