global:
  domain: {{ argocd_fqdn }}

configs:
  secret:
    # bcrypt hash is required — Ansible's password_hash filter handles this
    argocdServerAdminPassword: "{{ argocd_admin_password | password_hash('bcrypt') }}"

  cm:
    url: "https://{{ argocd_fqdn }}"
    application.instanceLabelKey: argocd.argoproj.io/app-name
{% if argocd_ldap.enabled %}
    dex.config: |
      connectors:
        - type: ldap
          id: ldap
          name: LDAP
          config:
            host: "{{ argocd_ldap.host }}:{{ argocd_ldap.port }}"
            insecureNoSSL: {{ argocd_ldap.insecure | lower }}
            startTLS: {{ argocd_ldap.start_tls | lower }}
            bindDN: "{{ argocd_ldap.bind_dn }}"
            bindPW: "{{ argocd_ldap.bind_password }}"
            usernamePrompt: Username
            userSearch:
              baseDN: "{{ argocd_ldap.user_search.base_dn }}"
              filter: "{{ argocd_ldap.user_search.filter }}"
              username: "{{ argocd_ldap.user_search.username_attr }}"
              idAttr: "{{ argocd_ldap.user_search.id_attr }}"
              emailAttr: "{{ argocd_ldap.user_search.email_attr }}"
              nameAttr: "{{ argocd_ldap.user_search.name_attr }}"
            groupSearch:
              baseDN: "{{ argocd_ldap.group_search.base_dn }}"
              filter: "{{ argocd_ldap.group_search.filter }}"
              nameAttr: "{{ argocd_ldap.group_search.name_attr }}"
{% endif %}

  rbac:
    policy.default: role:readonly
    policy.csv: |
      # ---- Admin ----
      p, role:admin, applications, *, */*, allow
      p, role:admin, clusters,     *, *,   allow
      p, role:admin, repositories, *, *,   allow
      p, role:admin, projects,     *, *,   allow
      p, role:admin, accounts,     *, *,   allow
      p, role:admin, exec,         create, */*, allow

      # ---- Dev ----
      p, role:dev, applications, get,    */*, allow
      p, role:dev, applications, sync,   */*, allow
      p, role:dev, applications, create, */*, allow
      p, role:dev, applications, update, */*, allow
      p, role:dev, repositories, get,    *,   allow
      p, role:dev, projects,     get,    *,   allow

      # ---- Readonly ----
      p, role:readonly, applications, get, */*, allow
      p, role:readonly, clusters,     get, *,   allow
      p, role:readonly, repositories, get, *,   allow
      p, role:readonly, projects,     get, *,   allow

      # ---- AWX deploy (sync AWX app only) ----
      p, role:awx-deploy, applications, get,    */awx/*, allow
      p, role:awx-deploy, applications, sync,   */awx/*, allow
      p, role:awx-deploy, applications, update, */awx/*, allow

      # ---- LDAP group bindings ----
      g, {{ argocd_rbac.admin.groups    | join(', ') }}, role:admin
      g, {{ argocd_rbac.dev.groups      | join(', ') }}, role:dev
      g, {{ argocd_rbac.readonly.groups | join(', ') }}, role:readonly
      g, {{ argocd_rbac.awx.groups      | join(', ') }}, role:awx-deploy

server:
  # HTTPS terminated at Traefik — ArgoCD runs plain HTTP internally
  extraArgs:
    - --insecure
  # No built-in ingress; we manage it via IngressRoute CRD below
  ingress:
    enabled: false

repoServer:
  replicas: 1

applicationSet:
  replicas: 1
