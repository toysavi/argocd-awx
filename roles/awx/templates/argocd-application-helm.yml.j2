apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: awx-operator
  namespace: {{ argocd_namespace }}
spec:
  project: default
  source:
    repoURL: {{ awx_helm_repo }}
    chart: awx-operator
    targetRevision: "{{ awx_chart_version if awx_chart_version != '' else '*' }}"
    helm:
      releaseName: awx-operator
      values: |
        AWX:
          enabled: true
          name: awx
          spec:
            admin_user: admin
            admin_password_secret: awx-admin-password
            service_type: ClusterIP
            ingress_type: none
            projects_persistence: true
            projects_existing_claim: ""
            projects_storage_size: 8Gi
            projects_storage_access_mode: ReadWriteOnce
            projects_storage_class: local-path
            web_resource_requirements:
              requests:
                cpu: 200m
                memory: 512Mi
              limits:
                cpu: 1000m
                memory: 2Gi
            task_resource_requirements:
              requests:
                cpu: 200m
                memory: 512Mi
              limits:
                cpu: 2000m
                memory: 4Gi
  destination:
    server: https://kubernetes.default.svc
    namespace: {{ awx_namespace }}
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
    syncOptions:
      - CreateNamespace=false
